# ─────────────────────────────────────────────────────────────────────────────
# ApplyFlow — Ortam Değişkenleri
# cp .env.example .env   ve değerleri düzenle
# .env dosyasını ASLA repoya commit etme!
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=applyflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=applyflow

# ── API (doğrudan Python'dan çalıştırırken kullanılır) ──
# Docker Compose içinde bu değer otomatik oluşturulur.
DATABASE_URL=postgresql+asyncpg://applyflow:changeme@localhost:5432/applyflow

# ── ChromaDB ──
# Docker Compose: servis adı "chroma", port 8000
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Ollama (yerel makinede çalışır, container dışında) ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── API Sunucu ──
API_PORT=8000
DEBUG=false
